+    /// Like [`tick`](Self::tick), but the overworld's map and sprites come out
+    /// transparent (alpha 0), so the page can paint its own world underneath
+    /// the game's text boxes, START menu and shop. Screens that own the whole
+    /// display (battle, party, bag…) come out opaque, except the battle's
+    /// opening flash and wipe, whose overworld backdrop is transparent too.
+    pub fn tick_layers(&mut self, input_bitmask: u8) -> Vec<u8> {
+        use pokered_app::render::set_hidden_world;
+        use pokered_core::battle::{BattlePhase, IntroPhase};
+        self.input.set_from_bitmask(input_bitmask);
+        self.game.update(&self.input);
+        self.input.begin_frame();
+        let n = SCREEN_W as usize * SCREEN_H as usize * 4;
+        let mut out = vec![0u8; n];
+        let over_world = matches!(
+            self.game.state.screen,
+            GameScreen::Overworld | GameScreen::StartMenu | GameScreen::Shop(_)
+        ) && self.game.overworld.pending_pokedex_entry.is_none()
+            && !self.game.overworld.is_party_select_active()
+            && !self.game.overworld.is_naming_screen_active();
+        if over_world {
+            // Draw twice, clearing to white then black where the map would
+            // be: whatever differs is the map.
+            set_hidden_world(Some(0));
+            self.game.draw(&mut self.fb);
+            self.fb.to_rgba(&mut out);
+            set_hidden_world(Some(3));
+            self.game.draw(&mut self.fb);
+            set_hidden_world(None);
+            let mut dark = vec![0u8; n];
+            self.fb.to_rgba(&mut dark);
+            for (a, b) in out.chunks_exact_mut(4).zip(dark.chunks_exact(4)) {
+                if a[..3] != b[..3] {
+                    a[3] = 0;
+                }
+            }
+            return out;
+        }
+        let intro = matches!(self.game.state.screen, GameScreen::Battle)
+            && matches!(
+                &self.game.battle.phase,
+                BattlePhase::Intro {
+                    phase: IntroPhase::TransitionFlash | IntroPhase::BattleTransitionWipe(_),
+                    ..
+                }
+            );
+        if intro {
+            // The opening snapshot of the overworld is taken now: blank white.
+            set_hidden_world(Some(0));
+        }
+        self.game.draw(&mut self.fb);
+        set_hidden_world(None);
+        self.fb.to_rgba(&mut out);
+        if intro {
+            for px in out.chunks_exact_mut(4) {
+                if px[0] == 0xff && px[1] == 0xff && px[2] == 0xff {
+                    px[3] = 0;
+                }
+            }
+        }
+        out
+    }

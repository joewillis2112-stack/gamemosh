+    /// Pokécraft: Minecraft items in a Pokémon battle. Each works on the
+    /// Pokémon it fits, the way it works on the Minecraft animal: SHEARS on
+    /// fluffy ones (wool comes off, and with it some DEFENSE), WHEAT on
+    /// cattle-like ones, a BONE on dog-like ones, a RAW COD on cat-like ones
+    /// (they calm down: ATTACK falls). On anything else it's not the time.
+    /// Returns false for every other item.
+    fn use_pokecraft_item(&mut self, item_id: ItemId) -> bool {
+        use crate::battle::stat_stages::StatIndex;
+        use pokered_data::species::Species as Sp;
+        if !matches!(item_id, ItemId::Shears | ItemId::Wheat | ItemId::Bone | ItemId::RawCod) {
+            return false;
+        }
+        let player = self.player_name.clone().unwrap_or_else(|| "RED".to_string());
+        let Some(species) = self.battle_state.as_ref().map(|bs| bs.enemy.active_mon().species) else {
+            return false;
+        };
+        let fits = match item_id {
+            ItemId::Shears => matches!(species, Sp::Jigglypuff | Sp::Wigglytuff | Sp::Clefairy | Sp::Clefable),
+            ItemId::Wheat => matches!(species, Sp::Tauros | Sp::Ponyta | Sp::Rapidash | Sp::Doduo | Sp::Dodrio | Sp::Kangaskhan | Sp::Rhyhorn),
+            ItemId::Bone => matches!(species, Sp::Growlithe | Sp::Arcanine | Sp::Vulpix | Sp::Ninetales),
+            _ => matches!(species, Sp::Meowth | Sp::Persian),
+        };
+        if !fits || !self.is_wild {
+            self.show_text_then(
+                vec![format!("OAK: {player}! This isn't\nthe time to use that!")],
+                BattlePhase::PlayerMenu,
+            );
+            return true;
+        }
+        let enemy = pokered_data::lang_data::species_name(species, false).to_uppercase();
+        let item = pokered_data::lang_data::item_name(item_id, false);
+        let (stat, drop, line) = match item_id {
+            ItemId::Shears => (StatIndex::Defense, 1, format!("Sheared {enemy}'s\nfluffy coat!")),
+            ItemId::Wheat => (StatIndex::Attack, 1, format!("{enemy} munched\nthe WHEAT!")),
+            ItemId::Bone => (StatIndex::Attack, 2, format!("{enemy} is wagging\nits tail!")),
+            _ => (StatIndex::Attack, 1, format!("{enemy} purrs\nhappily!")),
+        };
+        let mut messages = vec![format!("{player} used\n{item}!"), line];
+        if let Some(ref mut bs) = self.battle_state {
+            if bs.enemy.stat_stages.modify(stat, -drop) {
+                let name = if stat == StatIndex::Defense { "DEFENSE" } else { "ATTACK" };
+                messages.push(format!("Enemy {enemy}'s\n{name} {}fell!", if drop > 1 { "greatly " } else { "" }));
+            } else {
+                messages.push("Nothing happened!".to_string());
+            }
+        }
+        // Shears are a tool; the food is eaten.
+        if item_id != ItemId::Shears {
+            self.consume_selected_item();
+        }
+        self.pokecraft_used.push(format!("{:?}:{:?}", item_id, species));
+        self.bag_menu = None;
+        self.sync_display_from_state();
+        self.show_text_then(messages, BattlePhase::EnemyFreeTurnAfterItem);
+        true
+    }

+/// Pokécraft: when set, the overworld draws no map and no sprites; it clears
+/// to this shade (0 white, 3 black) instead, so a page can paint its own world
+/// underneath and key out the pixels that differ between two clear shades.
+static HIDDEN_WORLD: core::sync::atomic::AtomicU8 = core::sync::atomic::AtomicU8::new(0xff);
+
+pub fn set_hidden_world(shade: Option<u8>) {
+    HIDDEN_WORLD.store(shade.unwrap_or(0xff), core::sync::atomic::Ordering::Relaxed);
+}
+
+fn hidden_world() -> Option<Rgba> {
+    match HIDDEN_WORLD.load(core::sync::atomic::Ordering::Relaxed) {
+        0 => Some(Rgba::WHITE),
+        3 => Some(Rgba::BLACK),
+        _ => None,
+    }
+}

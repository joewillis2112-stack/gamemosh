diff --git a/core/src/time.rs b/core/src/time.rs
new file mode 100644
index 0000000..9e35496
--- /dev/null
+++ b/core/src/time.rs
@@ -0,0 +1,62 @@
+//! `Instant` for timings and metrics. `std::time::Instant::now` panics in the
+//! browser build (wasm32-unknown-unknown has no clock), so there it reads zero.
+
+#[cfg(not(target_arch = "wasm32"))]
+pub use std::time::Instant;
+
+#[cfg(target_arch = "wasm32")]
+pub use browser::Instant;
+
+#[cfg(target_arch = "wasm32")]
+mod browser {
+    use std::ops::{Add, AddAssign, Sub};
+    use std::time::Duration;
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+    pub struct Instant;
+
+    impl Instant {
+        pub fn now() -> Self {
+            Instant
+        }
+        pub fn elapsed(&self) -> Duration {
+            Duration::ZERO
+        }
+        pub fn duration_since(&self, _: Instant) -> Duration {
+            Duration::ZERO
+        }
+        pub fn saturating_duration_since(&self, _: Instant) -> Duration {
+            Duration::ZERO
+        }
+        pub fn checked_duration_since(&self, _: Instant) -> Option<Duration> {
+            Some(Duration::ZERO)
+        }
+        pub fn checked_add(&self, _: Duration) -> Option<Instant> {
+            Some(Instant)
+        }
+        pub fn checked_sub(&self, _: Duration) -> Option<Instant> {
+            Some(Instant)
+        }
+    }
+    impl Add<Duration> for Instant {
+        type Output = Instant;
+        fn add(self, _: Duration) -> Instant {
+            Instant
+        }
+    }
+    impl AddAssign<Duration> for Instant {
+        fn add_assign(&mut self, _: Duration) {}
+    }
+    impl Sub<Instant> for Instant {
+        type Output = Duration;
+        fn sub(self, _: Instant) -> Duration {
+            Duration::ZERO
+        }
+    }
+    impl Sub<Duration> for Instant {
+        type Output = Instant;
+        fn sub(self, _: Duration) -> Instant {
+            Instant
+        }
+    }
+}
diff --git a/core/src/vfs.rs b/core/src/vfs.rs
new file mode 100644
index 0000000..5da260f
--- /dev/null
+++ b/core/src/vfs.rs
@@ -0,0 +1,93 @@
+//! File access for data loading. Natively this is `std::fs`. Once a bundle is
+//! mounted (the browser build, which has no file system), reads come from it.
+//! Natively, `record` lists every file a run touched, to build that bundle.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, OnceLock};
+
+static MOUNT: OnceLock<BTreeMap<String, Vec<u8>>> = OnceLock::new();
+static RECORD: Mutex<Option<BTreeSet<String>>> = Mutex::new(None);
+
+fn key(path: &Path) -> String {
+    path.to_string_lossy().replace('\\', "/")
+}
+
+fn note(path: &Path) {
+    if let Ok(mut guard) = RECORD.lock() {
+        if let Some(set) = guard.as_mut() {
+            set.insert(key(path));
+        }
+    }
+}
+
+/// Serve every later read from `files` (keys are full paths with `/`).
+pub fn mount(files: BTreeMap<String, Vec<u8>>) {
+    let _ = MOUNT.set(files);
+}
+
+/// Start listing every file read from disk.
+pub fn record() {
+    *RECORD.lock().expect("vfs record") = Some(BTreeSet::new());
+}
+
+/// The files read from disk since `record`.
+pub fn recorded() -> Vec<String> {
+    RECORD.lock().expect("vfs record").as_ref().map(|s| s.iter().cloned().collect()).unwrap_or_default()
+}
+
+pub fn read(path: &Path) -> Result<Vec<u8>, String> {
+    if let Some(files) = MOUNT.get() {
+        return files.get(&key(path)).cloned().ok_or_else(|| format!("{}: not in the data bundle", path.display()));
+    }
+    note(path);
+    std::fs::read(path).map_err(|e| format!("{}: {e}", path.display()))
+}
+
+pub fn read_to_string(path: &Path) -> Result<String, String> {
+    String::from_utf8(read(path)?).map_err(|e| format!("{}: {e}", path.display()))
+}
+
+pub fn is_file(path: &Path) -> bool {
+    match MOUNT.get() {
+        Some(files) => files.contains_key(&key(path)),
+        None => path.is_file(),
+    }
+}
+
+pub fn is_dir(path: &Path) -> bool {
+    match MOUNT.get() {
+        Some(files) => {
+            let prefix = format!("{}/", key(path).trim_end_matches('/'));
+            files.range(prefix.clone()..).next().is_some_and(|(k, _)| k.starts_with(&prefix))
+        }
+        None => path.is_dir(),
+    }
+}
+
+/// Direct children of `dir` as (path, is_dir), in name order.
+pub fn list_dir(dir: &Path) -> Result<Vec<(PathBuf, bool)>, String> {
+    if let Some(files) = MOUNT.get() {
+        let prefix = format!("{}/", key(dir).trim_end_matches('/'));
+        let mut out: BTreeMap<String, bool> = BTreeMap::new();
+        for (k, _) in files.range(prefix.clone()..).take_while(|(k, _)| k.starts_with(&prefix)) {
+            let rest = &k[prefix.len()..];
+            match rest.split_once('/') {
+                Some((first, _)) => { out.insert(first.to_owned(), true); }
+                None => { out.entry(rest.to_owned()).or_insert(false); }
+            }
+        }
+        return Ok(out.into_iter().map(|(name, d)| (dir.join(name), d)).collect());
+    }
+    let mut out = Vec::new();
+    for entry in std::fs::read_dir(dir).map_err(|e| format!("{}: {e}", dir.display()))? {
+        let path = entry.map_err(|e| e.to_string())?.path();
+        let is_dir = path.is_dir();
+        if !is_dir {
+            note(&path);
+        }
+        out.push((path, is_dir));
+    }
+    out.sort();
+    Ok(out)
+}

 impl LuaImpl {
+    /// Read a numeric Lua global for the host, following a dotted path
+    /// (`"room.x"`) through nested tables. Booleans read as 0/1.
+    pub fn global_number(&self, path: &[u8]) -> Option<f64> {
+        let mut cur = value::Value::Table(std::rc::Rc::clone(&self.interp.globals));
+        for part in path.split(|b| *b == b'.') {
+            let next = match &cur {
+                value::Value::Table(t) => t.borrow().get(&value::Value::Str(std::rc::Rc::from(part))),
+                _ => return None,
+            };
+            cur = next;
+        }
+        match cur {
+            value::Value::Number(n) => Some(n),
+            value::Value::Bool(b) => Some(if b { 1.0 } else { 0.0 }),
+            _ => None,
+        }
+    }
+
     pub fn new() -> Self {
         let globals = Rc::new(RefCell::new(TableInner::new()));
         api::register_all(&globals);

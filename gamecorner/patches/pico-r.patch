+/// Read a numeric Lua global (dotted path, UTF-8 at `name_ptr`) so the host
+/// page can follow a cart's score or progress. NaN when unset or not a number.
+///
+/// # Safety
+///
+/// `name_ptr` must point to `name_len` readable bytes.
+#[no_mangle]
+pub unsafe extern "C" fn web_get_global(name_ptr: *const u8, name_len: u32) -> f64 {
+    let name = match unsafe { wasm_bytes(name_ptr, name_len) } {
+        Some(n) => n,
+        None => return f64::NAN,
+    };
+    engine_mut()
+        .and_then(|e| e.lua.global_number(name))
+        .unwrap_or(f64::NAN)
+}

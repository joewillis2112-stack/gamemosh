+    // ── Game Corner Arcade bridge ────────────────────────────────────────
+
+    /// The player's Game Corner coin balance.
+    pub fn coins(&self) -> u32 {
+        self.game.save_data.game_data.player_coins as u32
+    }
+
+    /// Credit `amount` coins, capped at the COIN CASE's 9999, and return the
+    /// new balance.
+    pub fn add_coins(&mut self, amount: u32) -> u32 {
+        let gd = &mut self.game.save_data.game_data;
+        gd.player_coins = (gd.player_coins as u32).saturating_add(amount).min(9999) as u16;
+        gd.player_coins as u32
+    }
+
+    /// Whether the bag holds `item_const` (e.g. `"COIN_CASE"`).
+    pub fn has_item(&self, item_const: &str) -> bool {
+        self.game.save_data.game_data.bag.has_item_const(item_const)
+    }
+
+    /// Put `quantity` of `item_const` in the bag. `false` when the name is
+    /// unknown or the bag is full.
+    pub fn give_item(&mut self, item_const: &str, quantity: u8) -> bool {
+        match ItemId::from_const_name(item_const) {
+            Some(item) => self
+                .game
+                .save_data
+                .game_data
+                .bag
+                .add_item(item, quantity.max(1))
+                .is_ok(),
+            None => false,
+        }
+    }
+
+    /// Close the slot-machine screen unplayed and return to the overworld,
+    /// so the host page can run its own game in its place. `false` when the
+    /// slots aren't open.
+    pub fn leave_slots(&mut self) -> bool {
+        if self.game.state.screen != GameScreen::Slots {
+            return false;
+        }
+        self.game.slots_screen = None;
+        self.game.handle_transition(GameScreen::Overworld);
+        true
+    }
+
+    /// Render `frames` stereo frames (interleaved L/R) of game audio at
+    /// `sample_rate`, for the page's own audio graph. Silence when muted.
+    pub fn render_audio(&self, frames: u32, sample_rate: u32) -> Vec<f32> {
+        let mut out = vec![0.0f32; frames as usize * 2];
+        if let Some(audio) = self.game.audio.as_ref() {
+            audio.render_pcm_at(&mut out, sample_rate);
+        }
+        out
+    }
+
